# Blinks Bright — environment variables
# Copy this file to .env and fill in your own keys:  cp .env.example .env

# OpenAI — chat model (gpt-5.4-mini-2026-03-17) + text-embedding-3-small
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — optional; not needed to run the chatbot
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment QR (PromptPay) — the image the assistant shows for every payment.
# Put your QR at web/assets/images/payment-qr.png, or point this elsewhere under web/.
PAYMENT_QR_IMAGE=/assets/images/payment-qr.png

# Resend — booking-confirmation email (+ .ics attachment). Leave blank to disable.
# EMAIL_FROM needs a domain verified in Resend; without one, leave it blank to use
# onboarding@resend.dev (delivers only to your own Resend account email — testing only).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=bookings@yourdomain.com
